<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android">

    <!-- To record what you say. The recordings are written to the app's own storage and
         turned into words on the phone. -->
    <uses-permission android:name="android.permission.RECORD_AUDIO" />

    <!-- For one thing only: downloading the listening model for a language other than
         English, when that is chosen in the settings (hearing/Speech.kt). Nothing the app
         records or writes is ever sent anywhere. -->
    <uses-permission android:name="android.permission.INTERNET" />

    <!-- Armed for the night is a foreground service: it has to keep hearing the volume
         keys, and keep the microphone, with the screen off and the phone locked. -->
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE" />

    <!-- One buzz when it starts recording and two when it stops, which is all the feedback
         there is: nothing lights the screen at night. -->
    <uses-permission android:name="android.permission.VIBRATE" />

    <!-- Keeps the processor, never the screen, awake while it records and transcribes. -->
    <uses-permission android:name="android.permission.WAKE_LOCK" />

    <queries>
        <!-- Lets the menu over a dream's words list other apps' text actions, such as Define
             from the Dictionary. Without it Android 11+ hides them from this app. -->
        <intent>
            <action android:name="android.intent.action.PROCESS_TEXT" />
            <data android:mimeType="text/plain" />
        </intent>
        <!-- Notes, for "Keep dreams in Notes": its provider is invisible to this app without
             this. Notes does any syncing; this app still has no network permission. -->
        <package android:name="com.wanderwildwood.oboegaki" />
    </queries>

    <application
        android:allowBackup="false"
        android:icon="@drawable/ic_launcher_mudita"
        android:roundIcon="@drawable/ic_launcher_mudita"
        android:label="@string/app_name"
        android:supportsRtl="false"
        android:theme="@style/Theme.App">

        <activity
            android:name=".MainActivity"
            android:exported="true"
            android:launchMode="singleTask"
            android:screenOrientation="portrait"
            android:configChanges="keyboardHidden|orientation|screenSize">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
        </activity>

        <service
            android:name=".night.ArmService"
            android:exported="false"
            android:foregroundServiceType="microphone|mediaPlayback" />

    </application>

</manifest>
